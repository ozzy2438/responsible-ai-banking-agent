APP_ENV=local
IDENTITY_PROVIDER=simulated
REASONING_PROVIDER=stub
SECRET_SOURCE=env
DATABASE_URL=postgresql://banking_app:app-local-only@127.0.0.1:55440/banking
MIGRATION_DATABASE_URL=postgresql://banking_migration:migration-local-only@127.0.0.1:55440/banking
APP_DB_PASSWORD=app-local-only
SIMULATED_IDENTITIES_FILE=.local/identities.json
POLICY_BUNDLE_PATH=policies
SESSION_COOKIE_SECURE=false
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
LOG_FORMAT=text

# Production-like environments must use IDENTITY_PROVIDER=oidc,
# SECRET_SOURCE=files, secure cookies, JSON logging, and explicit hosts.
# Secret files are read from SECRETS_DIR using lower-case names such as
# database_url, openai_api_key, and app_db_password.
# SECRETS_DIR=/run/secrets/responsible-banking-agent
# OIDC_ISSUER=https://identity.example-bank.invalid
# OIDC_AUDIENCE=responsible-banking-agent
# OIDC_JWKS_URL=https://identity.example-bank.invalid/.well-known/jwks.json
# OIDC_ALGORITHMS=RS256
# OIDC_ACTOR_ID_CLAIM=actor_id
# OIDC_ROLE_CLAIM=role
# OIDC_NAME_CLAIM=name
# OIDC_REVIEWER_ACR=urn:example-bank:assurance:high
# OIDC_SCOPE_CLAIM=scope
# OIDC_ASSIST_SCOPE=banking:assist
# OIDC_REVIEW_SCOPE=banking:review

# A production-like environment also requires a read-only HTTPS bank adapter
# with mTLS. BANK_API_TOKEN is read from the mounted bank_api_token secret file.
# BANK_DATA_PROVIDER=http
# BANK_API_BASE_URL=https://api.example-bank.invalid
# BANK_API_CA_FILE=/run/secrets/responsible-banking-agent/bank_api_ca.pem
# BANK_API_CLIENT_CERT_FILE=/run/secrets/responsible-banking-agent/bank_api_client.pem
# BANK_API_CLIENT_KEY_FILE=/run/secrets/responsible-banking-agent/bank_api_client_key.pem
# BANK_API_TIMEOUT_SECONDS=3

# Production-like environments use the shared PostgreSQL limiter. The HMAC key
# is read from the mounted rate_limit_hmac_key secret file; raw IPs are not stored.
# RATE_LIMIT_BACKEND=postgres
# RATE_LIMIT_REQUESTS=120
# RATE_LIMIT_WINDOW_SECONDS=60
# MAX_REQUEST_BODY_BYTES=16384

# Optional; all three are required together. Never commit a real key.
# REASONING_PROVIDER=openai
# OPENAI_MODEL=
# OPENAI_API_KEY=
